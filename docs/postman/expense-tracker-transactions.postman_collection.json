        {
          "name": "Other user cannot access (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.collectionVariables.get(\"baseUrl\"); const email = `other_${Date.now()}@example.com`;",
                  "const json = b => ({ mode: \"raw\", raw: JSON.stringify(b) });",
                  "const hdr = [{ key: \"Content-Type\", value: \"application/json\" }];",
                  "pm.sendRequest({ url: base + \"/auth/register\", method: \"POST\", header: hdr, body: json({ email, password: \"Passw0rd123\" }) }, () =>",
                  "  pm.sendRequest({ url: base + \"/auth/login\", method: \"POST\", header: hdr, body: json({ email, password: \"Passw0rd123\" }) }, (e, res) =>",
                  "    pm.request.headers.upsert({ key: \"Authorization\", value: \"Bearer \" + res.json().access_token })));"
                ]
              }
            }
