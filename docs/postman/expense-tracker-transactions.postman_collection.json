                  "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));",
                  "pm.test(\"Error on field title\", () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include(\"title\"));",
                  "pm.test(\"Error on field amount\", () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include(\"amount\"));",
                  "pm.test(\"Error on field transaction_date\", () => pm.expect(pm.response.json().error.details.map(d => d.field)).to.include(\"transaction_date\"));"
