{
  "info": {
    "name": "Expense Tracker - Transactions",
    "description": "Transaction CRUD. Run top to bottom; Setup registers a fresh user and stores the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "Passw0rd123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "expenseCategoryId",
      "value": ""
    },
    {
      "key": "incomeCategoryId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `txn_${Date.now()}@example.com`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const cats = pm.response.json();",
                  "const by = n => cats.find(c => c.name === n).id;",
                  "pm.collectionVariables.set(\"expenseCategoryId\", by(\"Food & Dining\"));",
                  "pm.collectionVariables.set(\"incomeCategoryId\", by(\"Salary\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. CRUD",
      "item": [
        {
          "name": "POST expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set(\"transactionId\", t.id);",
                  "pm.test(\"Expense, amount normalised\", () => { pm.expect(t.type).to.eql(\"expense\"); pm.expect(t.amount).to.eql(\"12.50\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{expenseCategoryId}}\",\n  \"type\": \"expense\",\n  \"title\": \"Lunch\",\n  \"amount\": \"12.5\",\n  \"transaction_date\": \"2026-10-20\",\n  \"description\": \"With team\",\n  \"payment_method\": \"card\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "POST income",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.test(\"Type from category\", () => pm.expect(t.type).to.eql(\"income\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "`type` omitted: taken from the category.",
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{incomeCategoryId}}\",\n  \"title\": \"October salary\",\n  \"amount\": \"5000\",\n  \"transaction_date\": \"2026-10-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Both returned, newest first\", () => { pm.expect(t.total).to.eql(2); pm.expect(t.items[0].title).to.eql(\"Lunch\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&page_size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "GET list - filtered",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Only income\", () => { pm.expect(t.total).to.eql(1); pm.expect(t.items[0].type).to.eql(\"income\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/transactions?type=income&start_date=2026-10-01&end_date=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "income"
                },
                {
                  "key": "start_date",
                  "value": "2026-10-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "GET one",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "{{transactionId}}"
              ]
            }
          }
        },
        {
          "name": "PUT replace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Replaced; omitted fields cleared\", () => {",
                  "  pm.expect(t.title).to.eql(\"Team dinner\"); pm.expect(t.amount).to.eql(\"48.00\");",
                  "  pm.expect(t.description).to.be.null; pm.expect(t.payment_method).to.be.null; });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Full replacement: description and payment_method were not sent, so they are cleared.",
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "{{transactionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{expenseCategoryId}}\",\n  \"title\": \"Team dinner\",\n  \"amount\": \"48\",\n  \"transaction_date\": \"2026-10-21\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH partial",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Only amount changed\", () => { pm.expect(t.amount).to.eql(\"50.00\"); pm.expect(t.title).to.eql(\"Team dinner\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "",
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "{{transactionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Validation & errors",
      "item": [
