# Used when running the backend directly on your machine (not via docker compose).
DATABASE_URL=postgresql+asyncpg://expense:expense@localhost:5432/expense_tracker
JWT_SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(64))"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173
# development | test | production (anything else fails at startup)
ENVIRONMENT=development
# AI financial assistant (Claude). Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
