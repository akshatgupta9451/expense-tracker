# ---- Postgres ----
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# ---- Backend ----
# development | test | production (anything else fails at startup)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://expense:expense@db:5432/expense_tracker
# Also stores rate-limit counters, so limits hold across all backend workers.
REDIS_URL=redis://redis:6379/0
# Must be replaced: the backend refuses to start with this value or anything under 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173

# ---- Storage (exports) ----
S3_ENDPOINT_URL=
S3_BUCKET=expense-exports
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- AI financial assistant (Claude) ----
ANTHROPIC_API_KEY=

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
